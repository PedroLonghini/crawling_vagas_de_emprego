# Ambiente: development, staging ou production.
OBS_ENVIRONMENT=development
OBS_LOG_LEVEL=INFO

# Endereço do MongoDB usado durante o desenvolvimento.
#
# Este valor não possui senha porque representa um MongoDB
# instalado no próprio computador.
OBS_MONGODB_URI=mongodb://127.0.0.1:27017/

# Nome do banco de desenvolvimento.
OBS_MONGODB_DATABASE=observatorio_vagas_dev

# Tempo máximo de espera pela conexão, em milissegundos.
OBS_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Armazenamento local durante o desenvolvimento.
OBS_RAW_STORAGE_PATH=data/raw

# API do Empregos. Não coloque uma chave real neste arquivo.
#
# O caminho e o cabeçalho ficam vazios até serem confirmados na
# documentação oficial fornecida pelo parceiro.
OBS_EMPREGOS_API_BASE_URL=https://api.exemplo.empregos.com.br
OBS_EMPREGOS_API_PUBLICATION_PATH=
OBS_EMPREGOS_API_AUTH_HEADER=
OBS_EMPREGOS_API_AUTH_PREFIX=
OBS_EMPREGOS_API_KEY=substitua-no-ambiente-seguro

# Kill switch: mantenha false até existirem token, endpoint oficial,
# fonte aprovada e testes concluídos no ambiente de homologação.
OBS_EMPREGOS_PUBLICACAO_HABILITADA=false

# Agregadores de vagas. Preencha somente depois de obter chave, aceitar os
# termos comerciais e aprovar a linha correspondente no catálogo.
OBS_ADZUNA_APP_ID=
OBS_ADZUNA_APP_KEY=
OBS_JOOBLE_API_KEY=

OBS_REQUEST_TIMEOUT_SECONDS=20
OBS_MAX_RETRIES=3
OBS_COLLECTION_INTERVAL_HOURS=24
